# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Logs
*.log

# -----------------------------
# ML / Model files
# -----------------------------
# Ignore trained models (can be large / regenerated)
models/*.pkl
models/*.joblib

# Optional: keep folder but ignore contents
!models/.gitkeep

# -----------------------------
# Data files
# -----------------------------
# Raw & processed data (optional – keep if you want reproducibility)
data/raw/*.csv
data/processed/*.csv
data/processed/*.pkl
data/processed/*.json

# If you WANT to track datasets, comment these lines above.

# -----------------------------
# FastAPI / Uvicorn
# -----------------------------
*.db
*.sqlite3

# -----------------------------
# OS / Editor
# -----------------------------
# Windows
Thumbs.db
Desktop.ini

# Mac
.DS_Store

# VS Code
.vscode/

# PyCharm
.idea/

# Jupyter
.ipynb_checkpoints/

# -----------------------------
# Environment variables
# -----------------------------
.env
.env.*
